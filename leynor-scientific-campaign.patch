+import { mkdir, writeFile } from 'node:fs/promises';
+import { analyzeDrawdownEpisodes } from '../../validation/scientificDrawdownDiagnostics.js';
+import { runMassSimulationDuration } from '../../leynor-premium-lab.js';
+
+export const COHORT = Object.freeze([
+  Object.freeze({ id: 'defensive', world: 0.30, asia: 0.10, cash: 0.60 }),
+  Object.freeze({ id: 'beginner', world: 0.50, asia: 0.15, cash: 0.35 }),
+  Object.freeze({ id: 'dynamic', world: 0.75, asia: 0.20, cash: 0.05 }),
+  Object.freeze({ id: 'world-only', world: 1, asia: 0, cash: 0 })
+]);
+export const FOLDS = Object.freeze([
+  Object.freeze({ id: 'fold-1', trainEnd: '2017-12', start: '2018-01', end: '2019-12' }),
+  Object.freeze({ id: 'fold-2', trainEnd: '2019-12', start: '2020-01', end: '2021-12' }),
+  Object.freeze({ id: 'fold-3', trainEnd: '2021-12', start: '2022-01', end: '2023-12' })
+]);
+const DF_GRID = Object.freeze([4, 6, 8, 12, 20]); const LAMBDA_GRID = Object.freeze([0.90, 0.94, 0.97]);
+function unix(date) { return Math.floor(Date.parse(`${date}T00:00:00Z`) / 1000); }
+async function fetchDaily(symbol) { const url=`https://query1.finance.yahoo.com/v8/finance/chart/${encodeURIComponent(symbol)}?period1=${unix('2014-06-02')}&period2=${unix('2023-12-31')+86400}&interval=1d&events=div%2Csplits&includeAdjustedClose=true`; const response=await fetch(url,{headers:{'user-agent':'LEYNOR-portfolio-cohort-confirmatory-v1/1.0'}}); if(!response.ok)throw new Error(`${symbol}: HTTP ${response.status}`); const payload=await response.json(); const r=payload?.chart?.result?.[0]; const prices=r?.indicators?.adjclose?.[0]?.adjclose; if(!r||!Array.isArray(prices))throw new Error(`${symbol}: réponse invalide`); return r.timestamp.map((timestamp,index)=>({date:new Date(timestamp*1000).toISOString().slice(0,10),price:prices[index]})).filter(x=>Number.isFinite(x.price)); }
+function aligned(a,b){const map=new Map(b.map(x=>[x.date,x.price]));return a.filter(x=>map.has(x.date)).map(x=>({date:x.date,world:x.price,asia:map.get(x.date)}));}
+function portfolio(rows,p){const first=rows[0];const ws=p.world/first.world;const as=p.asia/first.asia;return rows.map(r=>({date:r.date,value:ws*r.world+as*r.asia+p.cash}));}
+function monthEnds(path){const map=new Map();path.forEach(x=>map.set(x.date.slice(0,7),x));return [...map.values()].sort((a,b)=>a.date.localeCompare(b.date));}
+function monthlyReturns(path){const ends=monthEnds(path);return ends.slice(1).map((x,i)=>({month:x.date.slice(0,7),value:x.value/ends[i].value-1}));}
+function mean(v){return v.reduce((s,x)=>s+x,0)/v.length;} function variance(v){const m=mean(v);return v.reduce((s,x)=>s+(x-m)**2,0)/(v.length-1);}

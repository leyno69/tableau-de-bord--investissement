+test('évalue chaque fold sans utiliser sa validation pour sélectionner les paramètres',()=>{const series=[];for(let year=2014;year<=2023;year++)for(let month=1;month<=12;month++)series.push({month:`${year}-${String(month).padStart(2,'0')}`,value:((year+month)%7-3)/100});const result=evaluateSeries(series);assert.equal(result.length,3);assert.ok(result.every(x=>x.trainingCount>0&&x.validationCount===24));});

+import { mkdir,writeFile } from 'node:fs/promises';import { runMassSimulationDuration } from '../../leynor-premium-lab.js';import { evaluateIntervalCoverage,evaluateProbabilityCalibration } from '../../validation/portfolioProbabilityCalibration.js';import { COHORT } from '../portfolio-cohort-confirmatory-v1/run.mjs';
+function unix(d){return Math.floor(Date.parse(`${d}T00:00:00Z`)/1000);}async function fetchDaily(symbol){const url=`https://query1.finance.yahoo.com/v8/finance/chart/${encodeURIComponent(symbol)}?period1=${unix('2014-06-02')}&period2=${unix('2024-02-01')}&interval=1d&events=div%2Csplits&includeAdjustedClose=true`;const response=await fetch(url,{headers:{'user-agent':'LEYNOR-probability-calibration-v1/1.0'}});if(!response.ok)throw new Error(`${symbol}: HTTP ${response.status}`);const p=await response.json(),r=p?.chart?.result?.[0],v=r?.indicators?.adjclose?.[0]?.adjclose;if(!r||!Array.isArray(v))throw new Error('réponse invalide');return r.timestamp.map((t,i)=>({date:new Date(t*1000).toISOString().slice(0,10),price:v[i]})).filter(x=>Number.isFinite(x.price));}
+function align(a,b){const m=new Map(b.map(x=>[x.date,x.price]));return a.filter(x=>m.has(x.date)).map(x=>({date:x.date,world:x.price,asia:m.get(x.date)}));}function path(rows,p){const f=rows[0],ws=p.world/f.world,as=p.asia/f.asia;return rows.map(r=>({month:r.date.slice(0,7),value:ws*r.world+as*r.asia+p.cash}));}function monthEnds(values){const m=new Map();values.forEach(x=>m.set(x.month,x.value));return [...m].sort((a,b)=>a[0].localeCompare(b[0])).map(([month,value])=>({month,value}));}function returns(v){return v.slice(1).map((x,i)=>({month:x.month,value:x.value/v[i].value-1}));}function mean(v){return v.reduce((s,x)=>s+x,0)/v.length;}function variance(v){const m=mean(v);return v.reduce((s,x)=>s+(x-m)**2,0)/(v.length-1);}const ORIGINS=Object.freeze(Array.from({length:21},(_,i)=>{const year=2018+Math.floor(i/4),month=1+(i%4)*3;return `${year}-${String(month).padStart(2,'0')}`;}));
+function priorBaseRate(monthly,origin){const eligible=monthly.filter(x=>x.month<origin);let hits=0,total=0;for(let i=0;i+12<eligible.length;i++){total++;if(eligible[i+12].value/eligible[i].value>1)hits++;}return total?hits/total:.5;}
+export async function runProbabilityCalibration(){const [w,a]=await Promise.all([fetchDaily('IWDA.AS'),fetchDaily('PAEJ.PA')]),rows=align(w,a),portfolioResults=[];for(const [pi,p] of COHORT.entries()){const monthly=monthEnds(path(rows,p)),series=returns(monthly),records=[];for(const [oi,origin] of ORIGINS.entries()){const originIndex=monthly.findIndex(x=>x.month===origin);if(originIndex<0||originIndex+12>=monthly.length)continue;const training=series.filter(x=>x.month<origin).map(x=>x.value);if(training.length<36)continue;const annualReturn=(1+mean(training))**12-1,annualVolatility=Math.sqrt(variance(training)*12),report=runMassSimulationDuration({portfolioCount:5000,months:12,initialAmount:1,monthlyContribution:0,annualInflation:0,annualFees:0,goal:1,seed:20260809+pi*100+oi,allocation:[{id:p.id,label:p.id,weight:1,annualReturn,annualVolatility}]}),outcome=monthly[originIndex+12].value/monthly[originIndex].value,baseRate=priorBaseRate(monthly,origin);records.push(Object.freeze({portfolioId:p.id,asOf:origin,outcome,binaryOutcome:outcome>=1,probability:report.summary.goalProbability,benchmarkProbability:baseRate,intervals:Object.freeze({'0.5':Object.freeze({lower:report.summary.nominal.p25,upper:report.summary.nominal.p75}),'0.9':Object.freeze({lower:report.summary.nominal.p05,upper:report.summary.nominal.p95})})}));}const modelPairs=records.map(r=>({probability:r.probability,binaryOutcome:r.binaryOutcome})),benchmarkBrier=records.reduce((s,r)=>s+(r.benchmarkProbability-Number(r.binaryOutcome))**2,0)/records.length,calibration=evaluateProbabilityCalibration(modelPairs,.5);portfolioResults.push(Object.freeze({portfolioId:p.id,records:Object.freeze(records),coverage:evaluateIntervalCoverage(records),probability:Object.freeze({...calibration,dynamicBaseRateBrierScore:benchmarkBrier,beatsDynamicBaseRate:calibration.model.brierScore<benchmarkBrier})}));}const records=portfolioResults.flatMap(x=>x.records);return Object.freeze({schemaVersion:1,experimentId:'portfolio-probability-calibration-v1',status:'proxy-inconclusive',origins:ORIGINS,horizonMonths:12,simulationPathsPerForecast:5000,portfolios:Object.freeze(portfolioResults),aggregate:Object.freeze({rawForecastCount:records.length,coverage:evaluateIntervalCoverage(records),probability:evaluateProbabilityCalibration(records,.5),independentForecastCount:null,mayExposeRealWorldProbability:false}),engineModified:false,blockers:Object.freeze(['Données exactes/licenciées absentes.','Holdout vierge absent.','Fenêtres et portefeuilles dépendants.','Moins de 100 prévisions indépendantes démontrées.'])});}
+if(import.meta.url===`file://${process.argv[1]}`){const r=await runProbabilityCalibration();await mkdir('artifacts',{recursive:true});await writeFile('artifacts/portfolio-probability-calibration-v1.json',`${JSON.stringify(r,null,2)}\n`);process.stdout.write(`${JSON.stringify(r,null,2)}\n`);}

:root {
  --bg: #0b1020;
  --panel: #121a2f;
  --panel-soft: #18223c;
  --border: #263454;
  --text: #f5f7fb;
  --muted: #9eabc6;
  --accent: #6ee7b7;
  --accent-2: #60a5fa;
  --danger: #fb7185;
  --warning: #fbbf24;
  --shadow: 0 18px 60px rgba(0, 0, 0, .25);
}

* { box-sizing: border-box; }
body {
  margin: 0;
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  background: radial-gradient(circle at top left, #172340 0, var(--bg) 42%);
  color: var(--text);
  min-height: 100vh;
}
button, input, select { font: inherit; }
button { cursor: pointer; }

.topbar {
  max-width: 1500px;
  margin: 0 auto;
  padding: 34px 28px 18px;
  display: flex;
  justify-content: space-between;
  align-items: end;
  gap: 24px;
}
h1, h2, p { margin-top: 0; }
h1 { margin-bottom: 6px; font-size: clamp(1.9rem, 4vw, 3.6rem); line-height: .98; letter-spacing: -0.05em; }
h2 { margin-bottom: 0; font-size: 1.25rem; }
.subtitle { color: var(--muted); margin-bottom: 0; }
.eyebrow { color: var(--accent); font-size: .72rem; font-weight: 800; letter-spacing: .18em; margin-bottom: 8px; }
.topbar-actions { display: flex; gap: 12px; align-items: end; }

.shell { max-width: 1500px; margin: 0 auto; padding: 16px 28px 48px; }
.metric-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; margin-bottom: 14px; }
.metric-card, .panel {
  background: rgba(18, 26, 47, .88);
  border: 1px solid rgba(64, 84, 126, .45);
  box-shadow: var(--shadow);
  backdrop-filter: blur(14px);
}
.metric-card { padding: 20px; border-radius: 18px; }
.metric-card span, .metric-card small { color: var(--muted); }
.metric-card strong { display: block; font-size: 1.7rem; margin: 8px 0 3px; }

.layout-main { display: grid; grid-template-columns: minmax(0, 1.8fr) minmax(320px, .8fr); gap: 14px; }
.stack { display: grid; gap: 14px; align-content: start; }
.panel { padding: 18px; border-radius: 18px; overflow: hidden; }
.panel-head { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-bottom: 16px; }

.btn, .icon-btn {
  border: 1px solid transparent;
  border-radius: 11px;
  background: var(--accent);
  color: #062219;
  padding: 10px 14px;
  font-weight: 800;
}
.btn.secondary { background: transparent; color: var(--text); border-color: var(--border); }
.icon-btn { background: transparent; color: var(--muted); padding: 4px 8px; font-size: 1.5rem; }

.field { display: grid; gap: 6px; }
.field span { color: var(--muted); font-size: .78rem; font-weight: 700; }
.field input, .field select {
  width: 100%;
  background: #0d1529;
  border: 1px solid var(--border);
  color: var(--text);
  border-radius: 10px;
  padding: 10px 12px;
}
.field.compact select { min-width: 170px; }

.table-wrap { overflow-x: auto; }
table { width: 100%; border-collapse: collapse; min-width: 760px; }
th, td { padding: 13px 10px; text-align: left; border-bottom: 1px solid rgba(64, 84, 126, .28); }
th { color: var(--muted); font-size: .75rem; letter-spacing: .06em; text-transform: uppercase; }
td { font-size: .9rem; }
.asset-cell strong { display: block; }
.asset-cell small { color: var(--muted); }
.positive { color: var(--accent); }
.negative { color: var(--danger); }

.watch-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
.watch-card { background: var(--panel-soft); border: 1px solid var(--border); border-radius: 14px; padding: 14px; }
.watch-card-top { display: flex; justify-content: space-between; gap: 12px; }
.watch-card h3 { margin: 0; font-size: .96rem; }
.watch-card .ticker { color: var(--muted); font-size: .75rem; }
.watch-price { font-size: 1.25rem; font-weight: 800; margin: 14px 0 2px; }
.badge { display: inline-flex; padding: 5px 8px; border-radius: 999px; font-size: .72rem; font-weight: 800; background: #263454; color: #d8e2f7; }
.badge.buy { background: rgba(110,231,183,.14); color: var(--accent); }
.badge.sell { background: rgba(251,113,133,.14); color: var(--danger); }
.watch-note { color: var(--muted); font-size: .78rem; margin: 8px 0 0; }

.allocation-list, .alerts-list, .broker-list { display: grid; gap: 12px; }
.allocation-row { display: grid; gap: 7px; }
.allocation-meta { display: flex; justify-content: space-between; font-size: .84rem; }
.bar { height: 8px; background: #0d1529; border-radius: 999px; overflow: hidden; }
.bar > span { display: block; height: 100%; background: linear-gradient(90deg, var(--accent-2), var(--accent)); border-radius: inherit; }
.alert, .broker-row { border: 1px solid var(--border); border-radius: 12px; padding: 12px; background: rgba(13, 21, 41, .58); }
.alert strong, .broker-row strong { display: block; font-size: .88rem; }
.alert small, .broker-row small { color: var(--muted); }
.broker-row { display: flex; justify-content: space-between; align-items: center; gap: 12px; }

.empty { color: var(--muted); padding: 18px 0; }

dialog { width: min(720px, calc(100vw - 32px)); border: 1px solid var(--border); background: var(--panel); color: var(--text); border-radius: 18px; padding: 0; box-shadow: var(--shadow); }
dialog::backdrop { background: rgba(3, 7, 18, .72); backdrop-filter: blur(4px); }
.dialog-form { padding: 20px; }
.form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
.dialog-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 20px; }

@media (max-width: 1050px) {
  .metric-grid { grid-template-columns: repeat(2, 1fr); }
  .layout-main { grid-template-columns: 1fr; }
}
@media (max-width: 720px) {
  .topbar { align-items: stretch; flex-direction: column; padding: 24px 16px 12px; }
  .topbar-actions { align-items: stretch; flex-direction: column; }
  .shell { padding: 12px 16px 32px; }
  .metric-grid { grid-template-columns: 1fr; }
  .watch-grid { grid-template-columns: 1fr; }
  .form-grid { grid-template-columns: 1fr; }
}
